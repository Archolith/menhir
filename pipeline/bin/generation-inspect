#!/usr/bin/env bash
# Menhir production generation inspection — read-only.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
. "${SCRIPT_DIR}/lib.sh"

echo "current-generation:  $(gen_current)"
