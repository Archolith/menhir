[Unit]
Description=Menhir nightly backup (quiesced; takes the stack down)
Documentation=file:/usr/local/sbin/menhir-scheduled-backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
# The backup stops the stack, dumps, verifies by loading both dumps back,
# encrypts, then restarts. Generous ceiling; the wrapper records real elapsed.
TimeoutStartSec=21600
# On stop, finalize restarts the stack and waits for health (up to 240 s in
# release-lib wait_healthy); the 90 s default would SIGKILL it before the
# run markers are written.
TimeoutStopSec=300
# Install with:
#   install -o root -g root -m 0755 pipeline/scheduled-backup.sh \
#       /usr/local/sbin/menhir-scheduled-backup
# This previously pointed at /srv/menhir/production/pipeline/, a directory no
# release creates and which does not exist on the host -- every run would have
# been status=203/EXEC.
ExecStart=/usr/local/sbin/menhir-scheduled-backup
Nice=10
IOSchedulingClass=idle
