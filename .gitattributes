# Normalize line endings: store LF in the repo, check out LF on all platforms.
# Prevents the CRLF<->LF churn warnings on generated/data files.
* text=auto eol=lf

# Explicit text files
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
uv.lock text eol=lf

# Binary assets (never touch line endings)
*.png   binary
*.gif   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary

# Byte-exact ingress artifact captured from the running host; verify-artifacts
# compares installed-byte SHA-256, so line-ending normalisation breaks it.
deploy/cloudflared-config.yml -text
deploy/docker-compose.cloudflared.yml -text

# Published release-note archives are digest-bound by publication-receipt.json.
# Line-ending normalisation would change the bytes and fail _verify_publication.
deploy/changes/releases/** -text
