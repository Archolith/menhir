NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Menhir HTTP runtime (the hook defaults below assume this port).
MENHIR_API_HOST=127.0.0.1
MENHIR_API_PORT=8100
# MENHIR_TURNS_URL=http://127.0.0.1:8100/api/turn-evidence
# MENHIR_TOOL_EVENTS_URL=http://127.0.0.1:8100/api/tool-events

# Local LLM (llama.cpp / OpenAI-compatible)
# LOCAL_LLM_BASE_URL is the chat endpoint; LOCAL_LLM_EMBED_BASE_URL is used when
# your embed model runs on a separate server/port.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8081/v1
LOCAL_LLM_API_KEY=not-needed
LOCAL_LLM_CHAT_MODEL=qwen3.5-35b-a3b
LOCAL_LLM_EMBED_MODEL=
LOCAL_LLM_EMBED_BASE_URL=
SCHEDULER_URL=http://localhost:8082
# SCHEDULER_AUTO_START=0        # Set to 1 to auto-start the scheduler process
# SCHEDULER_OPEN_DASHBOARD=0    # Set to 1 to open the scheduler dashboard on startup
# SCHEDULER_PROJECT_DIR=        # Override the scheduler project directory
# SCHEDULER_MANAGER_PATH=       # Override the path to the scheduler manager script
# SCHEDULER_PYTHON=             # Override the Python interpreter for the scheduler

# Optional Langfuse tracing
# LANGFUSE_BASE_URL is also accepted for compatibility with existing local setups.
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-nano
OPENAI_EMBED_MODEL=text-embedding-3-small

# Gemini (alternative provider)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.5-flash

# Provider selection — pick one: local | openai | gemini
# All three (chat, graphiti LLM, graphiti embed) default to the same value.
# Set GRAPHITI_EMBED_PROVIDER or GRAPHITI_RERANKER_PROVIDER separately for hybrid setups
# (e.g. openai for extraction, local for embeddings).
LLM_CHAT_PROVIDER=local
GRAPHITI_LLM_PROVIDER=local
# GRAPHITI_EMBED_PROVIDER=        # inherits GRAPHITI_LLM_PROVIDER when blank
# GRAPHITI_RERANKER_PROVIDER=     # inherits GRAPHITI_LLM_PROVIDER when blank

# Optional guardrail for obviously oversized episode text before Graphiti extraction.
# Uses a rough chars/4 token estimate. Set to 0 to disable.
# NOTE: this measures the EPISODE TEXT only, which is ~1% of what actually gets sent.
# It cannot catch a context overrun -- see GRAPHITI_REQUEST_MAX_ESTIMATED_TOKENS below.
GRAPHITI_EPISODE_MAX_ESTIMATED_TOKENS=12000

# Guardrail on the ASSEMBLED extraction request (prompt + candidate entities + schema),
# checked immediately before the API call. Same rough chars/4 estimate. Set to 0 to disable.
# Keep it under the model's real context window so an overrun fails with a message that
# names its own cause, instead of an opaque provider 400 recorded as processing_error.
GRAPHITI_REQUEST_MAX_ESTIMATED_TOKENS=100000

# OUTPUT token cap for extraction LLM calls (code default 4096, see settings_model.llm_max_tokens).
# This caps the RESPONSE, not the prompt. Setting it too low truncates combined-extraction output
# mid-JSON on turns that yield long entity lists: graphiti_llm_patches detects the truncation and
# escalates (doubling, ceiling 16384), so the call recovers, but each event costs a wasted round
# trip. A local .env carried 1500 and hit this twice in a 1682-call benchmark run.
# Output tokens bill on ACTUAL usage, not on the cap, so a generous value is close to free --
# lower it only to bound a local model's response length.
# LLM_MAX_TOKENS=3000

# Typed-scalar consistency gate. POLICY: ON for benchmarking, OFF in production.
# The values below are the production defaults and are already what you get by NOT
# setting them -- they are written out here so the split is visible rather than implied.
#
# The gate groups k samples by an exact identity label and commits only what recurs in
# >= threshold*k of them. The model smears one fact's identity across subject/attribute/
# scope in arbitrary order, so exact-matching each field independently turns one AGREED
# fact into several single-vote claims that veto each other. Reconciliation votes on the
# identity TUPLE and takes the modal combination.
#
# Historical pre-binding measurement on the frozen LME panel (correct current Views out of 100):
#   threshold 1.0, no reconcile ...... 20   <- these defaults
#   threshold 2/3 + attribute ........ 65
#   + scope .......................... 70
#   + scope + subject ................ 72
# archolith-bench/scripts/longmemeval/config.sh turns all three on with threshold 2/3 for
# every LME build, which is where that grid comes from.
#
# DO NOT use this grid as the current baseline. It predates the resolved-twin non-self
# binding repair (1550c56) and the 2026-07-27 TurnEvidence/admission provenance work.
# Rebuild the knowledge-update corpus on current Menhir before comparing these flags.
#
# Not promoted to production because the gain is unvalidated at production scale (largest
# real namespace is ~9x the LME panel) and the flags are RECALL-AFFECTING, not neutral:
# more claims commit, so more assertions and Views are written. The reconciled name also
# lands in slot_key, so a namespace consolidated on-then-off can hold one fact under two
# slots -- bump MENHIR_PERSONAL_MEMORY_SCALAR_STATE_PERCEIVER_VERSION when flipping these
# on an existing namespace.
#
# THRESHOLD MUST BE THE RATIO `2/3`, never 0.67: 0.67 > 2/3, so at k=3 it still demands
# all three votes and silently buys nothing. menhir parses the ratio form for this reason.
# MENHIR_PERSONAL_MEMORY_SCALAR_THRESHOLD=1.0
# MENHIR_PERSONAL_MEMORY_SCALAR_RECONCILE_ATTRIBUTE=false
# MENHIR_PERSONAL_MEMORY_SCALAR_RECONCILE_SCOPE=false
# MENHIR_PERSONAL_MEMORY_SCALAR_RECONCILE_SUBJECT=false

# Observe-only deterministic typed-scalar shadow; it never changes memory persistence, authority,
# or recall. It is off by default. Audit recording requires
# MENHIR_PERSONAL_MEMORY_CONSOLIDATION_AUDIT_ENABLED=true.
# MENHIR_SCALAR_DETERMINISTIC_SHADOW=false

# OAuth resource-server mode for protected HTTP routes. Menhir can validate an
# external IdP's tokens or run its embedded authorization-code + PKCE server.
# When enabled, OAuth owns auth for /api/*, /mcp, /mcp/*, and /mcp-http.
# Static bearer keys and ?api_key= are not used on those routes.
# MENHIR_OAUTH_ENABLED=false
# MENHIR_PUBLIC_BASE_URL=https://memory.example.com
# MENHIR_OAUTH_RESOURCE=https://memory.example.com/mcp-http
# MENHIR_AUTHORIZATION_SERVERS=https://tenant.auth0.com
# MENHIR_OAUTH_ISSUER=https://tenant.auth0.com/
# MENHIR_OAUTH_JWKS_URI=https://tenant.auth0.com/.well-known/jwks.json
# MENHIR_OAUTH_AUDIENCE=https://memory.example.com/mcp-http
# MENHIR_OAUTH_SCOPES_SUPPORTED=menhir:read,menhir:write,menhir:admin
# MENHIR_OAUTH_READ_SCOPES=menhir:read
# MENHIR_OAUTH_WRITE_SCOPES=menhir:write
# MENHIR_OAUTH_ADMIN_SCOPES=menhir:admin
# MENHIR_OAUTH_JWKS_CACHE_TTL_S=300
# MENHIR_OAUTH_HTTP_TIMEOUT_S=5
# MENHIR_OAUTH_CLOCK_SKEW_S=60
# MENHIR_OAUTH_ALLOWED_ALGORITHMS=RS256

# Embedded OAuth authorization server. Production public URLs must use HTTPS;
# loopback HTTP is accepted for local development only.
# MENHIR_OAUTH_AS_ENABLED=false
# MENHIR_OAUTH_AS_DIR=
# MENHIR_OAUTH_AS_CODE_TTL_S=120
# MENHIR_OAUTH_AS_ACCESS_TTL_S=3600
# MENHIR_OAUTH_AS_CONSENT_SECRET=
# MENHIR_OAUTH_AS_CONSENT_TTL_S=300
# MENHIR_OAUTH_AS_SESSION_TTL_S=600
# MENHIR_OAUTH_AS_REGISTER_RATE=20
# MENHIR_OAUTH_AS_REGISTER_WINDOW_S=600
# MENHIR_OAUTH_AS_APPROVE_RATE=10
# MENHIR_OAUTH_AS_APPROVE_WINDOW_S=300
# MENHIR_OAUTH_AS_MAX_CLIENTS=1000
# MENHIR_OAUTH_AS_STALE_CLIENT_MAX_AGE_S=86400
# Refresh-token grant for the embedded AS. Off by default; when on, the token
# endpoint issues refresh tokens valid for MENHIR_OAUTH_AS_REFRESH_TTL_S
# seconds (default 30 days). Must be > 0.
# MENHIR_OAUTH_AS_REFRESH_TOKENS_ENABLED=false
# MENHIR_OAUTH_AS_REFRESH_TTL_S=2592000

# Trust forwarded client IPs only from these direct socket peers. Keep the
# default loopback peers for a same-host reverse proxy.
# MENHIR_TRUSTED_PROXY=false
# MENHIR_TRUSTED_PROXY_PEERS=127.0.0.1,::1

# Per-client identity and restrictions (CF-32).
#
# Clients identify themselves with the `X-Menhir-Client-Name` request header. Names are
# compared case-insensitively, and the same name must appear on both sides: in the client's
# own MCP config, and in one of the three settings below.
#
# All three are EMPTY by default, and an empty deployment has no per-client policy -- every
# caller is unrestricted and nothing below applies. Leave them unset unless you actually want
# to pin or restrict a client.
#
# THE PART THAT WILL SURPRISE YOU: the refusal is all-or-nothing on the DEPLOYMENT, not
# per-client. The moment you configure a pin or an allowlist for ONE client, EVERY other
# self-named client must be listed somewhere below or it is refused with
# "Unknown client name '<x>'". A client that worked yesterday stops working. That is
# deliberate -- refusing only *restricted* names would leave the evasion intact, since the
# evasion is to claim a name that is not restricted -- but it means adding your first pin is
# a breaking change for every other client. Add them all in the same edit.
#
# MENHIR_KNOWN_CLIENTS exists for exactly that: names that are RECOGNIZED but NOT restricted.
# Without it, making a client nameable would force a namespace pin on it as a side effect.
#
# MENHIR_CLIENT_NAMESPACES=client=namespace,other=other-namespace
#   Forces every read and write from that client into the named silo, overriding whatever
#   namespace the caller passes. Use it to keep one client's memory out of the primary graph.
# MENHIR_CLIENT_TOOLS=client=tool_a|tool_b
#   Restricts a client to a purpose-built toolset. Useful for a small model that cannot
#   navigate the full catalog. Unlisted clients are unaffected.
# MENHIR_KNOWN_CLIENTS=claude-code,codex,gemini
#   Recognized, unrestricted. List every remaining client here once you configure either
#   of the above.
#
# DO NOT list the fallback names `remote-mcp` or `remote-api` in MENHIR_KNOWN_CLIENTS if you
# rely on namespace pins. A caller that sends NO client-name header is assigned one of those
# two names automatically (api/auth.py: `client_name or default_client_name or "remote-mcp"`).
# Declaring them as known therefore makes "send no name at all" a recognized, unrestricted
# identity -- so any holder of the shared static key can shed its pin by simply omitting the
# header, which is the evasion the all-or-nothing refusal exists to close. Verified by
# execution 2026-08-20: with those names declared, an unnamed caller reaches tool dispatch
# successfully while a caller sending a WRONG name is refused.

# HTTP process settings captured once during startup.
# MENHIR_STARTUP_SCOPE=full
# MENHIR_CORS_ORIGINS=
# MENHIR_INSTANCE_ID=

# Work-artifact corpus reconciliation. Repository identity is explicit because
# worktree directory names are not stable graph locator keys.
# MENHIR_ARTIFACT_RECONCILE_MODE=audit  # off | audit | safe_apply
# MENHIR_ARTIFACT_RECONCILE_REPO=       # absolute working-tree path
# MENHIR_ARTIFACT_RECONCILE_REPOSITORY= # graph repository name, e.g. menhir

# Frontier retrieval / brief flags (experimental; all default OFF unless noted).
# Booleans accept true|1|yes. See .agent/plans/anecdotal-recall-oracle-ladder.md for rationale.
# MENHIR_FRONTIER_BRIEF_BUILDER=false   # build_context: append a temporal Timeline below the
#                                       # relevance list (safe/neutral on LME; enable to re-A/B)
# MENHIR_FRONTIER_FACT_EDGES=false      # inject RELATES_TO fact edges into the candidate pool
# MENHIR_FRONTIER_FACT_EDGE_MODE=standalone   # standalone | pointer
# MENHIR_FRONTIER_CONTENT_VECTOR=false  # add content_embedding cosine lane
# MENHIR_FRONTIER_CONTENT_VECTOR_REPLACE_NAME=false  # benchmark Arm C; BM25+content
# MENHIR_FRONTIER_CONTENT_VECTOR_K=100
# MENHIR_FRONTIER_CONTENT_VECTOR_WEIGHT=0.5
# MENHIR_FRONTIER_FUSION_ADMISSION_POLICY=attributed  # benchmark uses production_fused
# MENHIR_FRONTIER_WARDEN_GATE=false     # drop REFUSED / label FLAGGED (aggressive)
# MENHIR_FRONTIER_EVIDENCE_ANCHOR=true  # Guard-5 anchor; set FALSE for anecdotal/chat corpora

# MCP telemetry and runtime tuning
# MENHIR_MCP_TELEMETRY_DB=   # Override SQLite telemetry database path
# MENHIR_MCP_TIMEOUT=120     # Default MCP tool timeout in seconds
# MEMORY_BUILD_ID=                 # Override the runtime build identifier
# ENV_FILE=                        # Path to a custom .env file to load

# Graph explorer (standalone visualization UI)
# MENHIR_EXPLORER_HOST=127.0.0.1
# MENHIR_EXPLORER_PORT=8787

# ---------------------------------------------------------------------------
# LLM budget caps (CF-79 / CF-234 / CF-251)
# ---------------------------------------------------------------------------
# TWO INDEPENDENT CAPS THAT INTERACT. A job may only spend what the session window still
# allows, so the session cap must stay comfortably ABOVE the per-job cap -- otherwise a
# large job can never finish no matter how generous its own cap is. Set them together.
# That mismatch is exactly what broke: a 50-call window sat below the p90 of a single job
# while the per-job cap said 100, and 26 memories were stored but left unrecallable.
#
# Measured per-job traffic (CF-234, 244 real jobs):
#     p50 14    p90 45    p95 59    p99 84    max 140
# Measured per-episode cost during the 2026-08-23 repair: 14-67 calls, of which extraction
# is ~14 and post_process is the remainder.
#
# What a refusal COSTS, because these are not free to set too low:
#   per-job    -> deterministic. The episode is parked for manual review; a retry would
#                 reach the identical refusal. Nothing recovers it automatically.
#   session    -> time-bound. Retried automatically once the window rolls (CF-251).
# Either way the memory is stored but has no :Entity nodes, so recall cannot see it while
# add_memory has already reported success to the caller.
#
# Changing these needs a RESTART of `menhir serve` -- config defaults bind at import. A
# fix that is committed but not restarted onto is not in effect; that is what let the
# previous cap keep refusing for two days after it had been raised.

# Runaway guard for a single enrichment job. Sits above p99 (84) so normal work never
# trips it. Raising it above ~150 refuses nothing at all and stops being a control.
# MENHIR_MAX_LLM_CALLS_PER_JOB=100

# Rolling per-session ceiling. 5000 is deliberately unreachable by normal work rather
# than calibrated -- it bounds a runaway without throttling legitimate enrichment.
# Recalibrating from measured session traffic is still open.
# MENHIR_MAX_LLM_CALLS_PER_SESSION_WINDOW=5000

# Width of that rolling window, in seconds. Also the retry floor for a session refusal:
# the scheduler defers the retry past this, rather than using its ordinary 30s backoff.
# MENHIR_LLM_SESSION_WINDOW_SECONDS=900

# Embedding-identity override (CF-195)
# The embed stamp is `<base_url>|<embed_model>`, which detects a model change or an endpoint
# change. It CANNOT detect a weight swap behind the same alias at the same URL -- the GGUF file
# changes, the embedding space changes with it, and no configuration moves, so nothing re-embeds
# and old and new vectors sit in one cosine surface.
#
# Set this to any new value when you knowingly swap weights. It is APPENDED to the stamp, so it
# can only split one embedding identity into two -- never merge two real endpoints into one.
#
# LEAVE IT COMMENTED unless you mean it: any non-blank value re-embeds the WHOLE observation
# corpus on the next `backfill_assertion_embeddings` run. Blank or absent changes nothing.
# MENHIR_EMBED_VERSION=

# ---------------------------------------------------------------------------
# Production container deployment (deploy/docker-compose.production.yml)
# ---------------------------------------------------------------------------
# The production stack is a separate Compose project ("menhir-prod"). It is not
# driven by this file; these entries document the names/paths/placeholders the
# operator supplies to the compose file and the backup/restore helpers. NO
# credentials belong here or in Git or in the host environment - secrets are
# files under /srv/menhir/production/secrets/ (read-only bind mounts), mapped to
# env only inside the containers (menhir entrypoint / neo4j shim).

# --- Immutable, digest-pinned image references (required; refused when absent) ---
# MENHIR_IMAGE=<registry>/menhir:<version>@sha256:<digest>
# NEO4J_IMAGE=neo4j:5-community@sha256:<digest>

# --- Runtime mode ---
# MENHIR_RUNTIME_MODE=production            # production | candidate-readonly
# candidate-readonly additionally needs (see deploy/PRODUCTION.md):
#   MENHIR_STATE_ROOT=/srv/menhir/candidate/state
#   MENHIR_AUTHORITIES_READ_ONLY=true

# --- Public OAuth surface (issuer/resource/JWKS/audience are derived from the base) ---
# MENHIR_PUBLIC_BASE_URL=https://memory.ctharvey.me
# MENHIR_OAUTH_ENABLED=true                 # set by the compose file
# MENHIR_OAUTH_AS_ENABLED=true              # set by the compose file
# MENHIR_OAUTH_SCOPES_SUPPORTED=menhir:read,menhir:write   # admin scope absent
# MENHIR_OAUTH_AS_REFRESH_TOKENS_ENABLED=true
# MENHIR_OAUTH_AS_REFRESH_TTL_S=2592000
# MENHIR_OAUTH_AS_REFRESH_RETRY_GRACE_S=5

# --- Immutable client policy (read-only policy mount) ---
# MENHIR_CLIENT_POLICY_PATH=/srv/menhir/production/policy/client-policy.json
# MENHIR_CLIENT_POLICY_DIGEST=<64-char-lowercase-sha256>   # REQUIRED

# --- Production hardening ---
# MENHIR_PRIVACY_REDACT=true                # required by production startup

# --- Fixed host paths (defaults shown) ---
# MENHIR_PROD_ROOT=/srv/menhir/production
# MENHIR_PROD_STATE_DIR=/srv/menhir/production/state
# MENHIR_STATE_ROOT=/srv/menhir/production/state      # active writable state
# MENHIR_PROD_SECRETS_DIR=/srv/menhir/production/secrets
# MENHIR_PROD_POLICY_DIR=/srv/menhir/production/policy
# MENHIR_BACKUP_ROOT=/srv/menhir/backups
# MENHIR_MAINTENANCE_LOCK=/run/lock/menhir-production.lock
# MENHIR_BACKUP_WRAPPER=/usr/local/sbin/menhir-backup-upload

# --- Neo4j (password comes from secrets/neo4j-password, never from env) ---
# NEO4J_URI=bolt://neo4j:7687               # set by the compose file
# NEO4J_USER=neo4j
# NEO4J_DATABASE=neo4j

# --- Provider selection + models (API keys come from secret files, not here) ---
# LLM_CHAT_PROVIDER=openai
# GRAPHITI_LLM_PROVIDER=openai
# GRAPHITI_EMBED_PROVIDER=openai
# OPENAI_CHAT_MODEL=gpt-4.1-nano
# OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Reverse proxy ---
# MENHIR_TRUSTED_PROXY=1                    # set by the compose file
# MENHIR_TRUSTED_PROXY_PEERS=<proxy-ip>     # REQUIRED; reverse proxy peer on menhir-proxy
