Cmnd_Alias MENHIR_SCAFFOLD_READ = \
    /srv/menhir/scaffold/bin/menhir_scaffold.py verify, \
    /srv/menhir/scaffold/bin/menhir_scaffold.py verify --app-only, \
    /srv/menhir/scaffold/bin/menhir_scaffold.py status

Cmnd_Alias MENHIR_APP_ONLY = \
    /srv/menhir/scaffold/bin/menhir_app_only.py classify *, \
    /srv/menhir/scaffold/bin/menhir_app_only.py deploy *, \
    /srv/menhir/scaffold/bin/menhir_app_only.py adopt *, \
    /srv/menhir/scaffold/bin/menhir_app_only.py recover, \
    /srv/menhir/scaffold/bin/menhir_app_only.py live, \
    /srv/menhir/scaffold/bin/menhir_app_only.py check, \
    /srv/menhir/scaffold/bin/menhir_app_only.py receipt

Cmnd_Alias MENHIR_SECURITY_CONFIG = \
    /srv/menhir/scaffold/bin/menhir_security_config.py classify *, \
    /srv/menhir/scaffold/bin/menhir_security_config.py deploy *, \
    /srv/menhir/scaffold/bin/menhir_security_config.py adopt *, \
    /srv/menhir/scaffold/bin/menhir_security_config.py recover, \
    /srv/menhir/scaffold/bin/menhir_security_config.py receipt

Cmnd_Alias MENHIR_PERSONAL_STAGE = \
    /usr/bin/python3 /srv/menhir/scaffold/bin/menhir_stage_vps.py *

Cmnd_Alias MENHIR_MAINTENANCE_ADMISSION = /srv/menhir/scaffold/bin/menhir_scaffold.py begin-maintenance *, /srv/menhir/scaffold/bin/menhir_scaffold.py complete-maintenance *

%menhir-operators ALL=(root) NOPASSWD: MENHIR_SCAFFOLD_READ, MENHIR_APP_ONLY, MENHIR_SECURITY_CONFIG, MENHIR_PERSONAL_STAGE, MENHIR_MAINTENANCE_ADMISSION
