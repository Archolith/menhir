# Secrets for the full test deployment (deploy/docker-compose.full.yml).
# Copy to deploy/.env.deploy (gitignored) and fill in. NEVER commit the real file.

# OpenAI API key used by graphiti for entity extraction (chat) + embeddings.
# Models are set in the compose file (gpt-4.1-nano / text-embedding-3-small).
OPENAI_API_KEY=sk-proj-...

# Operator credential for the client-token tier. On a network/container bind the
# credential-free loopback bootstrap is disabled, so you need this to mint the
# first client token (see deploy/README.md).
MENHIR_OPERATOR_KEY=change-me-to-a-long-random-string
