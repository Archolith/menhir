# Root-owned release configuration. Copy to
# /srv/menhir/production/release/production.env as root:root 0600 and replace
# every angle-bracket placeholder. No secret values belong in this file.
MENHIR_IMAGE=<registry>/menhir:<version>@sha256:<64-lowercase-hex>
NEO4J_IMAGE=neo4j:<reviewed-version>-community@sha256:<64-lowercase-hex>
MENHIR_RELEASE_COMMIT=<40-lowercase-hex>
MENHIR_RELEASE_ID=menhir-prod-<version>-<sequence>
MENHIR_RUNTIME_MODE=production
MENHIR_INSTANCE_ID=<unique-target-instance-id>
MENHIR_PUBLIC_BASE_URL=https://memory.ctharvey.me
MENHIR_CLIENT_POLICY_DIGEST=09ede2c69a145ec551bcd51e037d8f825e6cc7fb211335450c1d736bb616d3b7
LLM_CHAT_PROVIDER=local
GRAPHITI_LLM_PROVIDER=local
GRAPHITI_EMBED_PROVIDER=openai
LOCAL_LLM_BASE_URL=https://openrouter.ai/api/v1
LOCAL_LLM_CHAT_MODEL=openai/gpt-5.6-luna
OPENAI_EMBED_MODEL=text-embedding-3-small
# Default-off authority boundary. A separately approved release may change this to `enforce` only
# after mounting the pinned Ed25519 public key and per-episode confirmations read-only, completing
# the exact-image/provider matrix, and recording rollback authority.
MENHIR_CANONICAL_SELF_BINDING_MODE=off
# MENHIR_CANONICAL_SELF_CONFIRMATION_PUBLIC_KEY_PATH=/run/secrets/menhir/canonical-self/owner-public.pem
# MENHIR_CANONICAL_SELF_CONFIRMATION_PUBLIC_KEY_SHA256=<64-lowercase-hex>
# MENHIR_CANONICAL_SELF_CONFIRMATION_DIRECTORY=/run/secrets/menhir/canonical-self/confirmations
# Scheduler task tracing. The scheduler is a developer-workstation service; no
# deployed host runs one, so the compose file already defaults this to 1 and the
# entry here is the explicit record. Set to 0 only alongside a reachable
# SCHEDULER_URL. Tracing is observability only; ingest and recall are unaffected.
SCHEDULER_TRACE_DISABLED=1
